# zsh interactive config. Linked to ~/.zshrc by install.sh.
# The bash configs (bash/) stay canonical for Linux VMs (install.sh --minimal);
# aliases are shared -- this file sources bash/aliases.

# MUST stay first: EDITOR=vim below would otherwise make zsh select the vi
# keymap at startup, killing alt+f/b/d word motion (reserved by the layering
# contract for readline/zle emacs-style word motion).
bindkey -e

# --- Environment (parity with bash/bashrc + bash/env) ---
typeset -U path
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH=$HOME/bin:$PATH
export EDITOR='vim'

# Added by Antigravity
[ -d "$HOME/.antigravity/antigravity/bin" ] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# Free ctrl+s from XOFF flow control -- it is the herdr prefix.
# Guarded: stty errors in non-interactive shells.
[[ -t 0 ]] && stty -ixon

# --- History (port of bash/config: big, deduped, shared across terminals) ---
HISTFILE=~/.zsh_history
HISTSIZE=70000
SAVEHIST=70000
# SHARE_HISTORY replaces bash's PROMPT_COMMAND="history -a; history -c; history -r"
setopt SHARE_HISTORY
# replaces HISTCONTROL=ignoredups:erasedups
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# --- Prompt (port of bash PS1: user:cyan-cwd, newline, cyan arrow) ---
PROMPT=$'%n:%F{cyan}%~\n⇨ %f '

# Terminal title. NOTE: herdr stores pane OSC titles for its sidebar but
# does NOT forward them to the outer terminal -- a pane's precmd can never
# retitle the Ghostty window (verified 2026-08-14 via aerospace
# list-windows vs herdr api snapshot). The window title is whatever the
# LAUNCHER shell last painted; the herdr() wrapper below owns that. In a
# pane, the [session] prefix (derived from HERDR_SOCKET_PATH: sessions
# live at ~/.config/herdr/sessions/<name>/, default at ~/.config/herdr/)
# only feeds herdr's sidebar terminal_title rows.
# %~ (tilde-abbreviated cwd), not %d: full paths made titles unreadable.
if [[ -n $HERDR_SOCKET_PATH ]]; then
  case $HERDR_SOCKET_PATH in
    */sessions/*/herdr.sock) _herdr_session=${${HERDR_SOCKET_PATH:h}:t} ;;
    *)                       _herdr_session=default ;;
  esac
  precmd() { print -Pn "\e]0;[${_herdr_session}] %~\a" }
else
  precmd() { print -Pn '\e]0;%n@%m %~\a' }
fi

# --- Behavior parity with bash ---
# unmatched globs pass through to the command instead of erroring
setopt NO_NOMATCH
setopt INTERACTIVE_COMMENTS

# Completion: brew-installed completions, then case-insensitive matching
# (port of bash/env's "bind set completion-ignore-case on").
FPATH="/opt/homebrew/share/zsh/site-functions:$FPATH"
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# interactive highlighted menu: Tab into it, arrows/Tab to move
zstyle ':completion:*' menu select

# --- Word motion: bash/readline parity ---
# zsh's default WORDCHARS counts / . - as word chars, so backward-kill-word
# eats whole paths. select-word-style bash = readline's alphanumeric-only
# words: alt+f/b/d and alt+backspace stop at every path segment, matching
# the bash muscle memory this file ports. Side effect, on purpose: ctrl+w
# (backward-kill-word) now stops at / too; the whole-argument kill moves
# to alt+shift+backspace below. Must stay BEFORE the plugin block -- the
# plugins wrap whatever widgets exist when they load.
autoload -Uz select-word-style
select-word-style bash
# alt+shift+backspace = kill whole whitespace-delimited argument (path).
# Legacy terminal encoding drops shift on backspace, so ghostty/config
# re-encodes the chord as ESC ctrl+h (\x1b\x08). Where that re-encode is
# absent (other terminals), the bytes degrade to plain backward-kill-word.
zle -N backward-kill-space-word backward-kill-word-match
zstyle :zle:backward-kill-space-word word-style space
bindkey '^[^H' backward-kill-space-word

# --- Shared aliases and functions (same file bash sources) ---
source ~/dotfiles/bash/aliases

# Launching herdr: stamp the OUTER window title with the session name
# first, so AltTab can tell two Ghostty windows on different herdr
# sessions apart (herdr never retitles the enclosing terminal itself).
# Only fires for TUI-attaching invocations from outside herdr; CLI
# subcommands (status, server, api, ...) and calls inside a pane pass
# through untouched. On detach the next precmd repaints the plain title.
herdr() {
  if [[ -z $HERDR_ENV ]]; then
    local s='' prev='' a
    for a in "$@"; do
      [[ $prev == --session ]] && s=$a
      [[ $a == --session=* ]] && s=${a#--session=}
      prev=$a
    done
    [[ ${1:-} == session && ${2:-} == attach && -n ${3:-} ]] && s=$3
    if (( $# == 0 )) || [[ -n $s || ${1:-} == --remote ]]; then
      print -n "\e]0;❐ ${s:-default}\a"
    fi
  fi
  command herdr "$@"
}

# --- fzf keybindings: ctrl+r history, ctrl+t files, alt+c cd (fzf >= 0.48) ---
command -v fzf >/dev/null && eval "$(fzf --zsh)"

# --- zoxide: frecency cd (z / zi) ---
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# --- Plugins (brew-installed; guarded so machines without them still work) ---
if [ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  # ctrl+space accepts the whole autosuggestion (alt+f takes it word-wise,
  # right-arrow also accepts). Claimants checked 2026-08: free in Ghostty/
  # herdr/AeroSpace; overrides zle set-mark; macOS input-source hotkey off.
  bindkey '^ ' autosuggest-accept
fi

# syntax highlighting must be sourced LAST (it wraps zle widgets)
[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section

