[user]
    name = Kay Zhu
    email = me@kayzhu.com

[core]
    excludesfile = ~/.gitignore_global
    editor = vim
    # delta must be installed (brew/apt install git-delta); on a VM
    # without it: git -c core.pager=less, or comment this and [interactive]
    pager = delta

[alias]
    # https://gist.github.com/2051932
    # I'm lazy, so two letters will always trump the full command
    co = checkout
    ci = commit
    cp = cherry-pick
    st = status
    br = branch
    df = diff
    lg = log -p

    # Show what the last pull/merge brought in
    lc = log ORIG_HEAD.. --stat --no-merges
    datetag = "!git tag `date '+%Y%m%d%H%M'`"

    # The first thing I run on a new project. Who has done the most damage
    who = shortlog -s --

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections

[merge]
    # zdiff3: diff3's 3-way view with common lines hoisted out of the hunks
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram

[pull]
    rebase = true

[fetch]
    prune = true

[rerere]
    enabled = true

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
