[user]
    name = Kay Zhu
    email = me@kayzhu.com

[core]
    excludesfile = ~/.gitignore_global
    editor = vim
    # delta (brew/apt install git-delta) when present; plain less otherwise,
    # so --minimal VMs without it keep a working git log/diff.
    pager = command -v delta >/dev/null 2>&1 && delta || less

[alias]
    # https://gist.github.com/2051932
    # I'm lazy, so two letters will always trump the full command
    co = checkout
    ci = commit
    cp = cherry-pick
    st = status
    br = branch
    df = diff
    lg = log -p

    # Show what the last pull/merge brought in
    lc = log ORIG_HEAD.. --stat --no-merges
    datetag = "!git tag `date '+%Y%m%d%H%M'`"

    # The first thing I run on a new project. Who has done the most damage
    who = shortlog -s --

[interactive]
    diffFilter = command -v delta >/dev/null 2>&1 && delta --color-only || cat

[delta]
    navigate = true  # use n and N to move between diff sections

[merge]
    # zdiff3: diff3's 3-way view with common lines hoisted out of the hunks
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram

[pull]
    rebase = true

[fetch]
    prune = true

[rerere]
    enabled = true

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
