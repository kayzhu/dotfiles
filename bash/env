# note: bind is used instead of setting these in .inputrc.
# This ignores case in bash completion (interactive shells only)
[[ $- == *i* ]] && bind "set completion-ignore-case on"

export EDITOR='vim'

export PATH=$HOME/bin:$PATH

# free ctrl+s from XOFF -- it is the herdr prefix (CLAUDE.md constraint 3)
[ -t 0 ] && stty -ixon

# NOTE: fzf and zoxide init live in bash/bashrc, AFTER bash/config: zoxide
# appends its hook to PROMPT_COMMAND, which config assigns.
# (bash-completion dropped 2026-08: zsh completion is native and bash is
# the VM-fallback shell, where the distro provides it.)
