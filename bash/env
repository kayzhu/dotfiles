# note: bind is used instead of setting these in .inputrc.
# This ignores case in bash completion (interactive shells only)
[[ $- == *i* ]] && bind "set completion-ignore-case on"

export EDITOR='vim'

export PATH=$HOME/bin:$PATH

# free ctrl+s from XOFF -- it is the herdr prefix (CLAUDE.md constraint 3)
[ -t 0 ] && stty -ixon

# fzf keybindings (ctrl+r history, ctrl+t files, alt+c cd) -- fzf >= 0.48
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

# zoxide: frecency cd (z / zi)
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"

# Use git autocompletion which is installed by `brew install bash-completion`.
[[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]] && . "/opt/homebrew/etc/profile.d/bash_completion.sh"
