# note: bind is used instead of setting these in .inputrc.
# This ignores case in bash completion (interactive shells only)
[[ $- == *i* ]] && bind "set completion-ignore-case on"

export EDITOR='vim'

export PATH=$HOME/bin:$PATH

# free ctrl+s from XOFF -- it is the herdr prefix (CLAUDE.md constraint 3)
[ -t 0 ] && stty -ixon

# bash-completion if installed (v1 formula for macOS's bash 3.2).
# fzf and zoxide init live in bash/bashrc, AFTER bash/config: zoxide
# appends its hook to PROMPT_COMMAND, which config assigns.
[[ $- == *i* && -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]] && . "/opt/homebrew/etc/profile.d/bash_completion.sh"
