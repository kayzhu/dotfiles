###############################################################################
# Shared aliases and functions -- sourced by BOTH bash (via bash/bashrc) and
# zsh (via zsh/zshrc). Keep everything here bash-AND-zsh compatible.
# Modern tools are guarded with command -v so
# machines without them (Linux VMs, fresh Macs) fall back cleanly.
###############################################################################

###############################################################################
# Private Aliases (not version controlled; absent on fresh clones)
###############################################################################
[ -r ~/dotfiles/bash/private_aliases ] && . ~/dotfiles/bash/private_aliases

###############################################################################
# Utilities
###############################################################################
alias c='clear'
alias grep='grep --color=auto'

# unified logging replaced /var/log/system.log in macOS 10.12
if [ "$(uname)" = Darwin ]; then
    alias systail='log stream --level info'
fi

# ripgrep and fd when available, classic forms otherwise
if command -v rg >/dev/null 2>&1; then
    alias g='rg -i'
else
    alias g='grep -i'
fi
if command -v fd >/dev/null 2>&1; then
    alias f='fd'
else
    alias f='find . -iname'
fi

take() {
    mkdir -p "$1"
    cd "$1"
}

# move to Trash instead of rm (ships with modern macOS)
command -v trash >/dev/null 2>&1 && alias rmf='trash'

###############################################################################
# Navigation and browsing
###############################################################################
alias ..='cd ..'
alias ...='cd ../..'
[ "$(uname)" = Darwin ] && alias o='open .'

command -v tree >/dev/null 2>&1 && alias tree='tree -CFh --du'

# eza when available; BSD/GNU ls fallbacks otherwise
if command -v eza >/dev/null 2>&1; then
    alias ls='eza'
    alias la='eza -a'
    alias ll='eza -l --git'
    alias lla='eza -la --git'
    # sort with recent modified first
    alias l='eza -la --git --sort=modified --reverse'
elif [ "$(uname)" = Darwin ]; then
    alias ls='ls -GFh'
    alias la='ls -FGAh'
    alias ll='ls -FGlh'
    alias lla='ls -FGlAh'
    alias l='ls -GFhltA'
else
    alias ls='ls --color=auto -Fh'
    alias la='ls --color=auto -AFh'
    alias ll='ls --color=auto -lFh'
    alias lla='ls --color=auto -lAFh'
    alias l='ls --color=auto -lAtFh'
fi

# lst: depth-capped tree view. eza's is git-aware; tree is the portable
# fallback. --level/-L is overridable (lst --level=4); eza's --git-ignore
# is a no-op outside a repo.
if command -v eza >/dev/null 2>&1; then
    alias lst='eza --tree --level=2 --git-ignore'
elif command -v tree >/dev/null 2>&1; then
    alias lst='tree -CFh -L 2'
fi

###############################################################################
# Processes
###############################################################################
if command -v htop >/dev/null 2>&1; then
    alias tu='htop --sort-key=PERCENT_CPU'
    alias tm='htop --sort-key=M_RESIDENT'
elif [ "$(uname)" = Darwin ]; then
    alias tu='top -o cpu'
    alias tm='top -o vsize'
fi
