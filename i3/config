# i3 config file (v4)
#
# REFERENCE CONFIG -- kept from the 2017 Debian desktop; no Linux desktop
# currently exists to verify against. AeroSpace (aerospace/aerospace.toml)
# is the living descendant of this layout grammar (hjkl focus, number
# workspaces). Modernized 2026-08: mlterm/Cinnamon-era autostarts removed.
#
# https://i3wm.org/docs/userguide.html

set $mod Mod4

font pango:monospace 10

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod
# drag tiling windows by their titlebar (i3 4.22+)
tiling_drag modifier titlebar

# stack-accent harmonization (CLAUDE.md constraint 6): focused border is the
# #474e91 accent, mirroring JankyBorders/herdr; 8px gaps echo aerospace.
# UNVERIFIED aesthetically -- tune on a real desktop.
default_border pixel 3
gaps inner 8
# class                 border  bg      text    indicator childborder
client.focused          #474e91 #474e91 #e4e4e4 #474e91   #474e91
client.focused_inactive #303030 #303030 #e4e4e4 #303030   #303030
client.unfocused        #303030 #080808 #8a8a8a #303030   #303030

# XDG autostart (generic; the 2017 Cinnamon daemons are gone)
exec --no-startup-id dex --autostart --environment i3

# suspend-aware screen locking
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c 000000

# terminal: ghostty runs on Linux too; fall back if absent
bindsym $mod+Return exec --no-startup-id sh -c 'command -v ghostty >/dev/null && exec ghostty || exec i3-sensible-terminal'

# kill focused window
bindsym $mod+Shift+q kill

# program launcher
bindsym $mod+d exec dmenu_run

# change focus (same hjkl grammar as AeroSpace alt+hjkl)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# split in horizontal / vertical orientation
bindsym $mod+g split h
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, default)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout default

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# reload / restart / exit (exit confirms via nagbar)
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3? This ends the X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (hjkl grammar; Shift shrinks)
mode "resize" {
    bindsym h resize grow   left  10 px or 10 ppt
    bindsym Shift+h resize shrink left  10 px or 10 ppt
    bindsym j resize grow   down  10 px or 10 ppt
    bindsym Shift+j resize shrink down  10 px or 10 ppt
    bindsym k resize grow   up    10 px or 10 ppt
    bindsym Shift+k resize shrink up    10 px or 10 ppt
    bindsym l resize grow   right 10 px or 10 ppt
    bindsym Shift+l resize shrink right 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# lock screen (routes through xss-lock's locker)
bindsym Mod1+Mod4+l exec --no-startup-id loginctl lock-session

# status bar
bar {
    status_command i3status
}

# volume (PulseAudio/PipeWire); refresh the bar immediately
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
